# Lore, cloud build to TestFlight (see CI-SETUP.md).
#
# Signing uses fastlane match (git storage) with the App Store Connect API key:
# match creates + stores an Apple Distribution certificate and App Store
# provisioning profiles for the app and the widget (encrypted in the lore-certs
# repo), and installs them into the CI keychain correctly. The project is then
# switched to MANUAL app-store signing so the archive uses those profiles.
#
# Secrets: ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_CONTENT (the API key),
# MATCH_PASSWORD (decrypts the certs), MATCH_GIT_BASIC_AUTHORIZATION (repo auth).

default_platform(:ios)

require_relative "lib/lore_release_tooling"

BUNDLE_ID = "com.erickdronski.lore"
WIDGET_ID = "com.erickdronski.lore.LoreWidget"
TEAM_ID = "J9DMDH4S58"
CERTS_REPO = "https://github.com/erickdronski/lore-certs.git"
REVIEW_LOCKING_STATES = %w[WAITING_FOR_REVIEW IN_REVIEW UNRESOLVED_ISSUES].freeze
VERSION_EDITABLE_AFTER_CANCEL_STATES = %w[
  PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED METADATA_REJECTED REJECTED READY_FOR_REVIEW
].freeze

# Authenticate Spaceship (the ASC API client) from the same secrets the other
# lanes use. ASC_KEY_CONTENT is stored base64-encoded. Defined at the top level
# of the Fastfile so every lane can call it directly.
def asc_token!
  require "spaceship"
  require "base64"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key: Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")),
  )
end

def ensure_app_store_release_mutation_allowed!
  LoreReleaseTooling.ensure_release_mutation_allowed!
rescue LoreReleaseTooling::Error => e
  UI.user_error!(e.message)
end

def ensure_review_hold_action_allowed!
  LoreReleaseTooling.ensure_review_hold_action_allowed!
rescue LoreReleaseTooling::Error => e
  UI.user_error!(e.message)
end

def verify_submission_screenshot_provenance!(options = {})
  release_source_sha = options[:release_source_sha].to_s.strip
  release_source_sha = ENV.fetch("RELEASE_SOURCE_SHA", "").strip if release_source_sha.empty?
  source_sha_path = File.expand_path("promo_screenshots/SOURCE_SHA", __dir__)
  repository = LoreReleaseTooling::GitRepository.new(File.expand_path("..", __dir__))
  LoreReleaseTooling::ScreenshotProvenance.new(
    source_sha_path: source_sha_path,
    release_source_sha: release_source_sha,
    repository: repository,
  ).verify!
rescue LoreReleaseTooling::Error => e
  UI.user_error!(e.message)
end

def verify_preflight!(reporter)
  reporter.verify!
rescue LoreReleaseTooling::PreflightFailed => e
  UI.user_error!(e.message)
end

def project_release_settings
  LoreReleaseTooling.project_release_settings(File.expand_path("../project.yml", __dir__))
end

def expected_release_version!(options)
  value = options[:expected_version].to_s.strip
  value = ENV.fetch("EXPECTED_VERSION", "") if value.empty?
  LoreReleaseTooling.release_version!(value, project_version: project_release_settings.fetch(:version))
rescue LoreReleaseTooling::Error => e
  UI.user_error!(e.message)
end

def expected_release_target!(options)
  expected_build = options[:expected_build].to_s.strip
  expected_build = ENV.fetch("EXPECTED_BUILD", "") if expected_build.empty?
  settings = project_release_settings
  LoreReleaseTooling::ReleaseTarget.new(
    expected_version: expected_release_version!(options), expected_build: expected_build,
    project_version: settings.fetch(:version), build_floor: settings.fetch(:build_floor),
  )
rescue LoreReleaseTooling::Error => e
  UI.user_error!(e.message)
end

def exact_app_store_version!(app, target)
  version = app.get_app_store_versions(filter: { platform: "IOS" }).find do |candidate|
    candidate.version_string == target.version
  end
  target.verify_version!(version)
rescue LoreReleaseTooling::Error => e
  UI.user_error!(e.message)
end

def verify_attached_release_build!(app, version, target)
  target.verify_version!(version)
  attached = version.get_build
  build = attached && Spaceship::ConnectAPI::Build.get(build_id: attached.id)
  target.verify_build!(build, app_id: app.id)
rescue LoreReleaseTooling::Error => e
  UI.user_error!(e.message)
end

def exact_processed_build!(app, target)
  builds = Spaceship::ConnectAPI::Build.all(
    app_id: app.id, version: target.version, build_number: target.build_number,
    platform: "IOS", processing_states: "VALID",
  )
  target.select_build!(builds, app_id: app.id)
rescue LoreReleaseTooling::Error => e
  UI.user_error!(e.message)
end

def refetch_app_store_version!(version)
  Spaceship::ConnectAPI::AppStoreVersion.get(
    app_store_version_id: version.id,
    includes: Spaceship::ConnectAPI::AppStoreVersion::ESSENTIAL_INCLUDES,
  )
end

def wait_for_review_cancellation!(submission_id)
  read_error = nil
  36.times do
    current = begin
                Spaceship::ConnectAPI::ReviewSubmission.get(
                  review_submission_id: submission_id,
                  includes: "appStoreVersionForReview,items",
                )
              rescue => e
                read_error = e
                UI.message("Review-submission read failed; retrying: #{e.class}")
                sleep(5)
                next
              end
    if current&.state == "COMPLETE"
      UI.success("Review submission #{submission_id} cancellation completed.")
      return true
    end
    read_error = nil
    UI.message("Waiting for review cancellation: submission state=#{current&.state || 'missing'}")
    sleep(5)
  end

  detail = read_error.nil? ? "" : " Last read failed with #{read_error.class}."
  UI.user_error!("Apple did not complete review cancellation within 3 minutes.#{detail}")
end

def wait_for_version_editable_after_review_cancel!(version)
  final_version = nil
  36.times do
    final_version = refetch_app_store_version!(version)
    break unless REVIEW_LOCKING_STATES.include?(final_version&.app_store_state)

    UI.message("Waiting for version to leave review: state=#{final_version.app_store_state}")
    sleep(5)
  end

  UI.user_error!("Apple no longer returned version #{version.version_string} after cancellation.") if final_version.nil?
  UI.user_error!(
    "Lore is not editable after cancellation; version #{version.version_string} is #{final_version.app_store_state}.",
  ) unless VERSION_EDITABLE_AFTER_CANCEL_STATES.include?(final_version.app_store_state)
  final_version
end

def review_submission_version_ids(submission_id)
  items = Spaceship::ConnectAPI::ReviewSubmissionItem.all(
    review_submission_id: submission_id,
    includes: "appStoreVersion",
  )
  items.map { |item| item.app_store_version&.id }
end

def verify_review_submission_version!(submission_id, version_id)
  LoreReleaseTooling.verify_review_item_versions!(
    review_submission_version_ids(submission_id), expected_version_id: version_id,
  )
rescue LoreReleaseTooling::Error => e
  UI.user_error!(e.message)
end

def wait_for_review_submission_item!(submission_id, version_id)
  current = nil
  12.times do
    current = Spaceship::ConnectAPI::ReviewSubmission.get(
      review_submission_id: submission_id,
      includes: "items,appStoreVersionForReview",
    )
    ids = review_submission_version_ids(submission_id)
    unless ids.empty?
      LoreReleaseTooling.verify_review_item_versions!(ids, expected_version_id: version_id)
      return current
    end

    UI.message("Waiting for review submission item to attach: submission=#{submission_id}")
    sleep(5)
  end

  count = current&.items.to_a.length
  UI.user_error!("Review submission #{submission_id} does not contain the App Store version item after waiting; item_count=#{count}.")
end

def wait_for_version_ready_for_review!(version)
  10.times do
    current = Spaceship::ConnectAPI::AppStoreVersion.get(app_store_version_id: version.id)
    return current if current.app_store_state == "READY_FOR_REVIEW" || current.app_version_state == "READY_FOR_REVIEW"

    UI.message("Waiting for version to become READY_FOR_REVIEW: state=#{current.app_store_state || current.app_version_state}")
    sleep(15)
  end

  refetch_app_store_version!(version)
end

def prepare_review_submission_for_version!(app:, platform:, version:)
  active = app.get_in_progress_review_submission(
    platform: platform,
    includes: "appStoreVersionForReview,items",
  )
  UI.user_error!(
    "Cannot submit #{version.version_string}: review submission #{active.id} is still #{active.state}.",
  ) unless active.nil?

  submission = app.get_ready_review_submission(platform: platform, includes: "items")
  if submission.nil?
    submission = app.create_review_submission(platform: platform)
  end

  begin
    submission.add_app_store_version_to_review_items(app_store_version_id: version.id)
  rescue => e
    raise e unless e.message =~ /already|exists|duplicate/i
    UI.important("Version is already an item on this submission; continuing.")
  end

  wait_for_review_submission_item!(submission.id, version.id)
  wait_for_version_ready_for_review!(version)
  Spaceship::ConnectAPI::ReviewSubmission.get(
    review_submission_id: submission.id,
    includes: "items,appStoreVersionForReview",
  )
end

platform :ios do
  desc "Run the release unit-test gate on an iPhone simulator"
  lane :tests do
    run_tests(
      project: "Lore.xcodeproj",
      scheme: "Lore",
      devices: ["iPhone 17 Pro"],
      ensure_devices_found: true,
      clean: true,
      result_bundle: true,
      output_directory: "build/test-results",
    )
  end

  desc "Capture App Store screenshots on the Simulator (no signing needed)"
  lane :screenshots do
    # Reads fastlane/Snapfile: boots the 6.9" Simulator, runs the LoreUITests
    # capturer (LoreScreenshots.swift) against the LoreScreenshots scheme, and
    # writes PNGs to fastlane/screenshots. Never touches signing or TestFlight.
    capture_ios_screenshots
  end

  desc "Upload the App Store marketing screenshots via the ASC API (no binary)"
  lane :screenshots_upload do |options|
    # Pure App Store Connect API upload of the pre-rendered marketing frames in
    # fastlane/promo_screenshots/en-US (1320x2868, the 6.9" slot that also fills
    # 6.7"/6.5"). skip_binary_upload + skip_metadata mean this touches ONLY the
    # screenshots on the editable version — never the build or the text metadata
    # (description/keywords stay exactly as set). Runs on Linux; no Xcode needed.
    ensure_app_store_release_mutation_allowed!
    verify_submission_screenshot_provenance!(options)

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )
    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      screenshots_path: "./fastlane/promo_screenshots",
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true,
    )
  end

  desc "READ-ONLY App Store submission preflight — reports the real ASC state"
  lane :preflight do |options|
    # Pure GET calls. Changes nothing. Every section is individually rescued so
    # one unsupported endpoint cannot blind the rest of the audit. Findings are
    # prefixed PF| so they can be grepped straight out of the CI log.
    reporter = LoreReleaseTooling::PreflightReporter.new do |status, label, detail|
      UI.message("PF|#{status}|#{label}|#{detail}")
    end
    say = ->(status, label, detail) { reporter.record(status, label, detail) }
    target = if options[:expected_version] || !ENV.fetch("EXPECTED_VERSION", "").empty?
               expected_release_target!(options)
             end

    begin
      asc_token!
    rescue => e
      say.call("FAIL", "Authentication", "App Store Connect token setup failed: #{e.message}")
      verify_preflight!(reporter)
    end

    app = begin
            Spaceship::ConnectAPI::App.find(BUNDLE_ID)
          rescue => e
            say.call("FAIL", "App", "lookup failed: #{e.message}")
            nil
          end
    if app.nil?
      say.call("FAIL", "App", "No app found for #{BUNDLE_ID}") if reporter.failures.empty?
      verify_preflight!(reporter)
    end
    say.call("INFO", "App", "#{app.name} (#{BUNDLE_ID}) id=#{app.id} locale=#{app.primary_locale}")

    # --- Every version and its state (an app with no EDITABLE version may still
    # have one parked in a non-editable state, e.g. Waiting for Review) ---
    begin
      all = app.get_app_store_versions
      if all.nil? || all.empty?
        say.call("FAIL", "Versions", "The app has NO App Store version records at all")
      else
        all.each do |v|
          say.call("INFO", "Version record", "#{v.version_string} state=#{v.app_store_state} platform=#{v.platform}")
        end
      end
    rescue => e
      say.call("FAIL", "Versions", "lookup failed: #{e.message}")
    end

    platform = Spaceship::ConnectAPI::Platform::IOS

    # --- Editable version + attached build (fall back to newest for the audit) ---
    version = nil
    begin
      version = app.get_edit_app_store_version
      if version
        say.call("INFO", "Editable version", "#{version.version_string} state=#{version.app_store_state} release=#{version.release_type}")
      else
        say.call("FAIL", "Editable version", "None — nothing staged to submit")
        version = begin
                    app.get_latest_app_store_version(platform: platform)
                  rescue
                    nil
                  end
        say.call("INFO", "Auditing instead", "newest version #{version&.version_string} state=#{version&.app_store_state}") if version
      end
    rescue => e
      say.call("FAIL", "Editable version", "lookup failed: #{e.message}")
    end

    begin
      b = version&.get_build
      b = Spaceship::ConnectAPI::Build.get(build_id: b.id) if b
      if b
        target&.verify_version!(version)
        target&.verify_build!(b, app_id: app.id)
        valid = b.processing_state == "VALID" && b.expired == false
        say.call(valid ? "PASS" : "FAIL", "Build attached", "build #{b.version} state=#{b.processing_state} expired=#{b.expired}")
      else
        say.call("FAIL", "Build attached", "No build attached to the editable version")
      end
    rescue => e
      say.call("FAIL", "Build attached", "lookup failed: #{e.message}")
    end

    begin
      # Build numbers can restart for a new marketing version, so sorting by
      # the integer alone can make an older 1.0 build look newer than 1.1.
      Spaceship::ConnectAPI::Build.all(
        app_id: app.id, sort: "-uploadedDate", limit: 5,
      ).first(5).each do |bd|
        say.call(
          "INFO", "TestFlight build",
          "#{bd.app_version} (#{bd.version}) uploaded=#{bd.uploaded_date} processing=#{bd.processing_state} expired=#{bd.expired}",
        )
      end
    rescue => e
      say.call("WARN", "TestFlight builds", "lookup failed: #{e.message}")
    end

    # --- Store listing text ---
    begin
      localizations = version&.get_app_store_version_localizations.to_a
      say.call("FAIL", "Listing text", "No version localizations returned") if localizations.empty?
      localizations.each do |loc|
        desc_len = loc.description.to_s.length
        say.call(desc_len > 10 ? "PASS" : "FAIL", "Description (#{loc.locale})", "#{desc_len} chars")
        say.call(loc.keywords.to_s.empty? ? "FAIL" : "PASS", "Keywords (#{loc.locale})", loc.keywords.to_s)
        say.call(loc.support_url.to_s.empty? ? "FAIL" : "PASS", "Support URL", loc.support_url.to_s)
        say.call(loc.marketing_url.to_s.empty? ? "WARN" : "PASS", "Marketing URL", loc.marketing_url.to_s)
        say.call(loc.whats_new.to_s.empty? ? "WARN" : "PASS", "What's New", "#{loc.whats_new.to_s.length} chars")
        say.call(loc.promotional_text.to_s.empty? ? "WARN" : "PASS", "Promo text", "#{loc.promotional_text.to_s.length} chars")

        # Screenshots per device slot
        begin
          sets = loc.get_app_screenshot_sets
          say.call("FAIL", "Screenshots (#{loc.locale})", "No screenshot sets returned") if sets.empty?
          sets.each do |set|
            n = set.app_screenshots&.count.to_i
            say.call(n.zero? ? "FAIL" : "PASS", "Screenshots #{set.screenshot_display_type}", "#{n} image(s)")
          end
        rescue => e
          say.call("FAIL", "Screenshots", "lookup failed: #{e.message}")
        end
      end
    rescue => e
      say.call("FAIL", "Listing text", "lookup failed: #{e.message}")
    end

    # --- Privacy policy + age rating (live on AppInfo, not the version) ---
    begin
      info = app.fetch_edit_app_info || app.fetch_live_app_info || app.fetch_latest_app_info
      if info.nil?
        say.call("FAIL", "AppInfo", "No AppInfo record returned")
      else
        say.call("INFO", "AppInfo", "state=#{info.state}")
        begin
          info.get_app_info_localizations.each do |il|
            next if il.privacy_policy_url.to_s.empty? && il.locale != app.primary_locale
            say.call(il.privacy_policy_url.to_s.empty? ? "FAIL" : "PASS",
                     "Privacy policy URL (#{il.locale})", il.privacy_policy_url.to_s)
          end
        rescue => e
          say.call("FAIL", "Privacy policy URL", "lookup failed: #{e.message}")
        end
        begin
          ard = info.fetch_age_rating_declaration
          say.call(ard.nil? ? "FAIL" : "PASS", "Age rating declaration", ard.nil? ? "missing" : "present")
        rescue => e
          say.call("FAIL", "Age rating", "lookup failed: #{e.message}")
        end
      end
    rescue => e
      say.call("FAIL", "AppInfo", "lookup failed: #{e.message}")
    end

    # --- Read actual subscription and one-time product status, without prices ---
    begin
      products = LoreReleaseTooling.product_catalog(Spaceship::ConnectAPI.tunes_request_client, app_id: app.id)
      products.each do |product|
        say.call("INFO", "Product", "#{product[:product_id]} type=#{product[:type]} state=#{product[:state]}")
      end
      %w[lore_plus_monthly lore_plus_annual lore_plus_lifetime].each do |identifier|
        matches = products.select { |product| product[:product_id] == identifier }
        if matches.length != 1
          say.call("FAIL", "Product #{identifier}", "Expected one product; found #{matches.length}")
        else
          state = matches.first.fetch(:state)
          say.call(state == "APPROVED" ? "PASS" : "FAIL", "Product #{identifier}", "state=#{state}")
        end
      end
    rescue => e
      say.call("FAIL", "Product catalog", "Read-only lookup failed: #{e.message}")
    end

    say.call(
      "WARN", "Subscriptions",
      "Product states are checked above; review screenshots, availability and agreements still need App Store Connect verification",
    )

    say.call(
      "WARN", "Privacy labels",
      "App privacy data categories are not exposed by this preflight; reconcile them manually with PrivacyInfo.xcprivacy and the privacy policy",
    )

    say.call(
      "WARN", "EU trader status",
      "Digital Services Act trader status is not exposed by this preflight; confirm it manually in App Store Connect",
    )

    # --- Already submitted? ---
    begin
      active_states = %w[
        WAITING_FOR_REVIEW IN_REVIEW UNRESOLVED_ISSUES CANCELING COMPLETING
      ]
      sub = app.get_review_submissions(
        filter: { platform: platform },
        includes: "appStoreVersionForReview,items",
      ).find { |candidate| active_states.include?(candidate.state) }
      if sub.nil?
        status = %w[WAITING_FOR_REVIEW IN_REVIEW].include?(version&.app_store_state) ? "WARN" : "INFO"
        detail = status == "WARN" ? "version remains #{version.app_store_state} without an active reviewSubmission" : "none in progress"
        say.call(status, "Existing submission", detail)
      else
        submitted_version = sub.app_store_version_for_review
        submitted_build = begin
                            submitted_version&.get_build
                          rescue
                            nil
                          end
        detail = "state=#{sub.state}"
        detail += " version=#{submitted_version.version_string}" unless submitted_version.nil?
        detail += " build=#{submitted_build.version}" unless submitted_build.nil?
        say.call("WARN", "Existing submission", detail)
      end
    rescue => e
      say.call("FAIL", "Existing submission", "lookup failed: #{e.message}")
    end

    # --- Why Apple rejected: Resolution Center. Without this the audit can see
    # that a version is REJECTED but never the reason, which is the only thing
    # that tells you what to fix. Read-only, and individually rescued because
    # the endpoint is absent for apps that were never rejected. ---
    begin
      # Unfiltered: a rejection thread can hang off a submission in any state,
      # and filtering by state risks missing the one that carries the reason.
      submissions = begin
                      app.get_review_submissions(sort: "-submittedDate", limit: 20)
                    rescue
                      []
                    end

      messages_seen = 0
      Array(submissions).each do |submission|
        # Call fetch_resolution_center_threads directly rather than
        # latest_resolution_center_messages: the latter does `threads.first
        # .fetch_messages` with no empty guard and raises NoMethodError for
        # every submission that was never rejected (i.e. the common case).
        threads = begin
                    submission.fetch_resolution_center_threads
                  rescue
                    []
                  end
        Array(threads).each do |thread|
          notes = begin
                    thread.fetch_messages
                  rescue
                    []
                  end
          Array(notes).each do |note|
            body = note.respond_to?(:message_body) ? note.message_body : note.to_s
            next if body.nil? || body.to_s.strip.empty?
            messages_seen += 1
            stamp = note.respond_to?(:created_date) ? note.created_date : nil
            # Collapse newlines: the PF| contract is one finding per line.
            flat = body.to_s.gsub(/\s+/, " ").strip[0, 1500]
            say.call("FAIL", "App Review message", "#{stamp} #{flat}".strip)
          end
        end
      end
      say.call("INFO", "App Review message", "no resolution center messages found") if messages_seen.zero?
    rescue => e
      say.call("WARN", "App Review message", "resolution center unavailable via API: #{e.message}")
    end

    say.call(
      "WARN", "Manual-only checks",
      "Paid Applications Agreement, tax and banking, subscription availability, offers, and review screenshots require App Store Connect UI confirmation",
    )

    verify_preflight!(reporter)
  end

  desc "Cancel the active App Review submission without changing or resubmitting a build"
  lane :hold_review do |options|
    ensure_review_hold_action_allowed!
    asc_token!

    expected_version = options[:expected_version].to_s
    expected_build = options[:expected_build].to_s
    UI.user_error!("expected_version is required") if expected_version.empty?
    UI.user_error!("expected_build is required") if expected_build.empty?
    UI.user_error!("expected_version must contain only numeric dot-separated components") unless expected_version.match?(/\A\d+(?:\.\d+)*\z/)
    UI.user_error!("expected_build must be a positive integer") unless expected_build.match?(/\A[1-9]\d*\z/)

    platform = Spaceship::ConnectAPI::Platform::IOS
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app for #{BUNDLE_ID}") if app.nil?

    version = app.get_app_store_versions(filter: { platform: platform }).find do |candidate|
      candidate.version_string == expected_version
    end
    UI.user_error!("No iOS App Store version #{expected_version}") if version.nil?

    build = version.get_build
    UI.user_error!("Version #{expected_version} has no attached build") if build.nil?
    UI.user_error!(
      "Refusing to cancel: expected #{expected_version} (#{expected_build}), " \
      "but Apple currently has #{version.version_string} (#{build.version}).",
    ) unless build.version.to_s == expected_build

    active_states = %w[
      WAITING_FOR_REVIEW IN_REVIEW UNRESOLVED_ISSUES CANCELING COMPLETING
    ]
    transition_states = %w[CANCELING COMPLETING]
    submission = app.get_review_submissions(
      filter: { platform: platform },
      includes: "appStoreVersionForReview,items",
    ).find { |candidate| active_states.include?(candidate.state) }
    submission_id = submission&.id

    unless submission.nil?
      submitted_version = submission.app_store_version_for_review
      UI.user_error!(
        "Refusing to cancel submission #{submission.id}: it is not bound to expected version #{expected_version}.",
      ) if submitted_version.nil? || submitted_version.id != version.id

      if transition_states.include?(submission.state)
        UI.important("Submission #{submission.id} is already #{submission.state}; waiting for Apple.")
      else
        UI.important(
          "Cancelling App Review submission #{submission.id} " \
          "state=#{submission.state} version=#{version.version_string} build=#{build.version}. " \
          "No build will be selected or submitted.",
        )
        submission = submission.cancel_submission
      end
    end

    if submission.nil? && %w[WAITING_FOR_REVIEW IN_REVIEW].include?(version.app_store_state)
      legacy = begin
                 version.fetch_app_store_version_submission
               rescue
                 nil
               end
      UI.user_error!(
        "Version #{expected_version} is #{version.app_store_state}, but Apple returned no cancellable submission.",
      ) if legacy.nil? || !legacy.can_reject

      UI.important(
        "Cancelling legacy App Review submission for #{version.version_string} (#{build.version}). " \
        "No build will be selected or submitted.",
      )
      legacy.delete!
    elsif submission.nil?
      safe_states = %w[
        PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED METADATA_REJECTED REJECTED READY_FOR_REVIEW
      ]
      UI.user_error!(
        "Version #{expected_version} is #{version.app_store_state}, not a confirmed held state.",
      ) unless safe_states.include?(version.app_store_state)
      UI.success("Lore #{expected_version} (#{expected_build}) is already held in #{version.app_store_state}.")
      next
    end

    unless submission_id.nil?
      completed = false
      read_error = nil
      36.times do
        current = begin
                    Spaceship::ConnectAPI::ReviewSubmission.get(
                      review_submission_id: submission_id,
                      includes: "appStoreVersionForReview,items",
                    )
                  rescue => e
                    read_error = e
                    UI.message("Review-submission read failed; retrying: #{e.class}")
                    sleep(5)
                    next
                  end
        if current&.state == "COMPLETE"
          completed = true
          break
        end
        read_error = nil
        UI.message("Waiting for review cancellation: submission state=#{current&.state || 'missing'}")
        sleep(5)
      end
      detail = read_error.nil? ? "" : " Last read failed with #{read_error.class}."
      UI.user_error!("Apple did not complete review cancellation within 3 minutes.#{detail}") unless completed
    end

    final_version = nil
    36.times do
      final_version = Spaceship::ConnectAPI::AppStoreVersion.get(
        app_store_version_id: version.id,
        includes: Spaceship::ConnectAPI::AppStoreVersion::ESSENTIAL_INCLUDES,
      )
      break unless %w[WAITING_FOR_REVIEW IN_REVIEW].include?(final_version&.app_store_state)
      UI.message("Waiting for version to leave review: state=#{final_version.app_store_state}")
      sleep(5)
    end

    UI.user_error!("Apple no longer returned version #{expected_version} after cancellation.") if final_version.nil?
    held_states = %w[
      PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED METADATA_REJECTED REJECTED READY_FOR_REVIEW
    ]
    UI.user_error!(
      "Lore is not confirmed held; version #{expected_version} is #{final_version.app_store_state}.",
    ) unless held_states.include?(final_version.app_store_state)

    final_build = final_version.get_build
    UI.user_error!("Attached build changed while holding review.") if final_build&.version.to_s != expected_build
    UI.success(
      "Lore #{expected_version} (#{expected_build}) is held in #{final_version.app_store_state}. " \
      "The attached build was not changed or resubmitted.",
    )
  end

  desc "Create the exact project version as manual release and set its release notes"
  lane :prepare_version do |options|
    ensure_app_store_release_mutation_allowed!
    expected_version = expected_release_version!(options)
    notes_path = File.expand_path("release_notes/#{expected_version}.en-US.txt", __dir__)
    UI.user_error!("Missing release notes for #{expected_version}") unless File.file?(notes_path)
    notes = File.read(notes_path).strip
    UI.user_error!("Release notes must contain 1–4000 characters") unless (1..4000).cover?(notes.length)
    asc_token!
    platform = Spaceship::ConnectAPI::Platform::IOS
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app for #{BUNDLE_ID}") if app.nil?
    version = LoreReleaseTooling.version_for_preparation!(
      app.get_app_store_versions(filter: { platform: platform }),
      expected_version: expected_version, editable_version: app.get_edit_app_store_version(platform: platform),
    )
    if version.nil?
      # Fastlane 2.237.0 App.ensure_version! can rename an unrelated version.
      # Its raw creation endpoint supports an explicit new MANUAL version.
      version = Spaceship::ConnectAPI.post_app_store_version(
        app_id: app.id,
        attributes: { versionString: expected_version, platform: platform, releaseType: "MANUAL" },
      ).to_models.first
    end
    UI.user_error!("Apple returned an unexpected version after preparation") unless version&.version_string == expected_version && version.platform == platform
    state = version.app_version_state || version.app_store_state
    UI.user_error!("Version #{expected_version} is not editable for metadata: #{state}") unless VERSION_EDITABLE_AFTER_CANCEL_STATES.include?(state)
    UI.user_error!("Version #{expected_version} is not held for manual release") unless version.release_type == "MANUAL"
    localization = version.get_app_store_version_localizations.find { |row| row.locale == "en-US" }
    if localization
      localization.update(attributes: { whats_new: notes })
    else
      version.create_app_store_version_localization(attributes: { locale: "en-US", whatsNew: notes })
    end
    saved = version.get_app_store_version_localizations.find { |row| row.locale == "en-US" }
    UI.user_error!("Release notes did not match after saving") unless saved&.whats_new == notes
    UI.success("Prepared #{expected_version} as MANUAL release. No build selected and no review submitted.")
  end

  desc "Attach an explicitly selected VALID nonexpired build without submitting review"
  lane :select_release_build do |options|
    ensure_app_store_release_mutation_allowed!
    verify_submission_screenshot_provenance!(options)
    target = expected_release_target!(options)
    asc_token!
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app for #{BUNDLE_ID}") if app.nil?
    version = exact_app_store_version!(app, target)
    state = version.app_version_state || version.app_store_state
    UI.user_error!("Version is not editable for build selection: #{state}") unless VERSION_EDITABLE_AFTER_CANCEL_STATES.include?(state)
    build = exact_processed_build!(app, target)
    version.select_build(build_id: build.id)
    verify_attached_release_build!(app, refetch_app_store_version!(version), target)
    UI.success("Selected #{target.version} (#{target.build_number}); no review submitted.")
  end

  desc "Submit the exact expected version and attached VALID build for review"
  lane :submit_for_review do |options|
    ensure_app_store_release_mutation_allowed!
    verify_submission_screenshot_provenance!(options)
    target = expected_release_target!(options)
    asc_token!
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app for #{BUNDLE_ID}") if app.nil?
    version = exact_app_store_version!(app, target)
    build = verify_attached_release_build!(app, version, target)
    UI.important("Submitting #{app.name} #{target.version} (#{target.build_number}) for review…")
    # The modern reviewSubmissions API replaced appStoreVersionSubmissions.
    submission = prepare_review_submission_for_version!(
      app: app, platform: Spaceship::ConnectAPI::Platform::IOS, version: version,
    )
    verify_attached_release_build!(app, refetch_app_store_version!(version), target)
    verify_review_submission_version!(submission.id, version.id)
    submission.submit_for_review
    UI.success("Submitted #{version.version_string} build #{build.version} for App Store review.")
  end

  desc "Swap the exact requested VALID build and resubmit; never select implicit latest"
  lane :swap_latest_build_and_resubmit do |options|
    ensure_app_store_release_mutation_allowed!
    verify_submission_screenshot_provenance!(options)
    target = expected_release_target!(options)
    asc_token!
    platform = Spaceship::ConnectAPI::Platform::IOS
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app for #{BUNDLE_ID}") if app.nil?
    version = exact_app_store_version!(app, target)
    selected_build = exact_processed_build!(app, target)
    current = version.get_build
    if current&.id == selected_build.id
      if %w[WAITING_FOR_REVIEW IN_REVIEW PENDING_DEVELOPER_RELEASE].include?(version.app_version_state || version.app_store_state)
        UI.user_error!("Expected build is already attached and version is in review or pending release; no resubmission performed.")
      end
    else
      existing = app.get_in_progress_review_submission(
        platform: platform, includes: "appStoreVersionForReview,items",
      )
      unless existing.nil?
        bound = existing.app_store_version_for_review
        UI.user_error!("Refusing to cancel a review submission for another version") unless bound&.id == version.id
        existing.cancel_submission
        wait_for_review_cancellation!(existing.id)
      end
      version = wait_for_version_editable_after_review_cancel!(version)
      target.verify_version!(version)
      version.select_build(build_id: selected_build.id)
    end
    version = refetch_app_store_version!(version)
    verify_attached_release_build!(app, version, target)
    submission = prepare_review_submission_for_version!(app: app, platform: platform, version: version)
    verify_attached_release_build!(app, refetch_app_store_version!(version), target)
    verify_review_submission_version!(submission.id, version.id)
    submission.submit_for_review
    UI.success("Submitted exact #{target.version} (#{target.build_number}) for App Store review.")
  end

  desc "Set the exact expected version and build to release after approval"
  lane :set_auto_release do |options|
    ensure_app_store_release_mutation_allowed!
    verify_submission_screenshot_provenance!(options)
    target = expected_release_target!(options)
    asc_token!
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No app for #{BUNDLE_ID}") if app.nil?
    version = exact_app_store_version!(app, target)
    verify_attached_release_build!(app, version, target)
    release_type = Spaceship::ConnectAPI::AppStoreVersion::ReleaseType::AFTER_APPROVAL
    version.update(attributes: { releaseType: release_type }) unless version.release_type == release_type
    updated = refetch_app_store_version!(version)
    verify_attached_release_build!(app, updated, target)
    UI.user_error!("Apple did not retain automatic release mode") unless updated.release_type == release_type
    UI.success("#{target.version} (#{target.build_number}) will release automatically after approval.")
  end

  desc "Build Lore and upload the build to TestFlight"
  lane :beta do
    # Local/manual invocations cannot bypass tests. CI sets LORE_TESTED=1 only
    # after the separate test step has passed for this exact checkout.
    tests unless ENV["LORE_TESTED"] == "1"

    # A clean, throwaway keychain on CI so codesign has somewhere to live.
    setup_ci

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
      is_key_content_base64: true,
    )

    # The App IDs (com.erickdronski.lore + .LoreWidget) are already registered
    # in the Developer portal, so there is no `produce` step: produce authenticates
    # with an Apple ID + password, not the App Store Connect API key, so it cannot
    # run headless here. match just needs the App IDs to exist, which they do.

    # Cert + App Store profiles for both bundle ids. readonly:false so the first
    # run creates and stores them; later runs just fetch and install.
    # force:true REGENERATES the profiles each run so a capability newly added to
    # the App ID (Sign in with Apple, 2026-07-16) is always reflected — a stale
    # stored profile would fail codesign with "provisioning profile doesn't
    # include the com.apple.developer.applesignin entitlement". The cert is
    # reused, not revoked.
    match(
      type: "appstore",
      api_key: api_key,
      app_identifier: [BUNDLE_ID, WIDGET_ID],
      git_url: CERTS_REPO,
      readonly: false,
      force: true,
    )

    # Force MANUAL app-store signing on the freshly generated project so the
    # archive uses the match profiles directly (no development profile, no
    # device requirement).
    update_code_signing_settings(
      path: "Lore.xcodeproj",
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      targets: ["Lore"],
      profile_name: "match AppStore #{BUNDLE_ID}",
    )
    update_code_signing_settings(
      path: "Lore.xcodeproj",
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      targets: ["LoreWidget"],
      profile_name: "match AppStore #{WIDGET_ID}",
    )

    # A monotonic CFBundleVersion: one above whatever TestFlight already has, so
    # a re-run never collides on the "must be higher than the previously
    # uploaded version" 409. Passing CURRENT_PROJECT_VERSION only as an xcarg did
    # NOT stick (the archive shipped as "1" every time), so write it into the
    # generated project with agvtool (needs VERSIONING_SYSTEM=apple-generic,
    # set in project.yml). Falls back to 0 when the app has no builds yet.
    app_version = get_version_number(
      xcodeproj: "Lore.xcodeproj",
      target: "Lore",
    )
    LoreReleaseTooling.release_version!(app_version, project_version: project_release_settings.fetch(:version))
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      version: app_version,
      initial_build_number: 0,
    )
    build_number = LoreReleaseTooling.next_build_number(
      project_floor: project_release_settings.fetch(:build_floor), latest: latest,
    )
    increment_build_number(
      xcodeproj: "Lore.xcodeproj",
      build_number: build_number,
    )

    build_app(
      project: "Lore.xcodeproj",
      scheme: "Lore",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      output_directory: "build",
      clean: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: {
          BUNDLE_ID => "match AppStore #{BUNDLE_ID}",
          WIDGET_ID => "match AppStore #{WIDGET_ID}",
        },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      # Do not block the runner waiting for Apple to finish processing; the
      # build shows up in TestFlight a few minutes later.
      skip_waiting_for_build_processing: true,
    )
  end
end
